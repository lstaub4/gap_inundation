# Function to assign CRS and reproject if needed
normalize_catalog_crs <- function(cat, is_harf2020 = FALSE) {
# If CRS is missing, assign EPSG:32149
if (is.na(st_crs(cat))) {
projection(cat) <- target_crs$proj4string
}
# If it's Harford 2020 (or whichever file is in EPSG:6487), reproject it
if (is_harf2020) {
cat <- catalog_reproject(cat, target_crs$proj4string)
}
return(cat)
}
