input_dirs = c(
"F:/MASTERS/THESIS/data/Clip/LAZ34/clipped_chunk_1.laz",
"F:/MASTERS/THESIS/data/Clip/LAZ30/clipped_chunk_1.laz"
),
tags = c("Harf2013", "Balt2015"),
output_file = "F:/MASTERS/THESIS/data/Merged/LGunF2013.laz"
)
